<Window x:Class="Ratchet.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ratchet.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1380">
    <Grid>
        <DataGrid x:Name="WeaponGrid" ItemsSource="{Binding WeaponBinding}" AlternatingRowBackground="#FFCECECE" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding SlotName}" Header="Slot Name" IsReadOnly="True" Width="175"/>
                <DataGridCheckBoxColumn Binding="{Binding Enabled}" Header="Enabled"/>
                <DataGridTextColumn Binding="{Binding Ammo}" Header="Ammo" Width="100"/>
                <DataGridComboBoxColumn x:Name="WeaponIDs" SelectedValueBinding="{Binding GunID}" Header="Gun ID"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="X" HorizontalAlignment="Left" Margin="130,696,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Y" HorizontalAlignment="Left" Margin="250,696,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Z" HorizontalAlignment="Left" Margin="370,696,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="XPosTextBox" HorizontalAlignment="Left" Margin="82,732,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="YPosTextBox" HorizontalAlignment="Left" Margin="207,732,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="ZPosTextBox" HorizontalAlignment="Left" Margin="332,732,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Click="SetPositionButton_Click" Content="Set Position" HorizontalAlignment="Left" Margin="457,731,0,0" VerticalAlignment="Top"/>
        <ComboBox SelectionChanged="PositionTypeOptions_SelectionChanged" x:Name="PositionTypeOptions" HorizontalAlignment="Left" Margin="82,763,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox TextChanged="IncrementPositionTextBox_TextChanged" x:Name="IncrementPositionTextBox" HorizontalAlignment="Left" Margin="207,765,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Click="IncrementPositionButton_Click" Content="Increment Position" HorizontalAlignment="Left" Margin="332,763,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
